# Copy to .env and fill in. Never commit .env.
# The pipeline loads this file on start without overriding real environment
# variables (GitHub Actions secrets and Cursor environment secrets win).

# --- Bluesky (daily ingest) ---
# Leave both blank to use anonymous public AppView search.
# GitHub-hosted runners and many cloud IPs get HTTP 403 on that path.
# Create an *app password* (never the account password):
#   1. https://bsky.app/settings/app-passwords
#   2. Name it perspectiverse-pipeline and copy it once
#   3. Put the same two values in GitHub Actions secrets
#      https://github.com/Data-Science-Link/perspectiverse/settings/secrets/actions
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Local labels (optional) ---
# Leave unset to skip Ollama and fall through to an API key or the heuristic.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI-compatible labels (DeepInfra recommended) ---
# About 50 short JSON calls per snapshot (10 planet names + faces/steelmans).
# Reuse the OPENAI_* names; the client is OpenAI-compatible.
# Create a token at https://deepinfra.com/dash then set:
#   GitHub Actions secrets OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL
# Llama 3.3 70B Turbo is ~$0.01/snapshot, ~$0.30/month on the daily job.
# Alternatives: deepseek-ai/DeepSeek-V4-Flash, Qwen/Qwen3.5-9B.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
