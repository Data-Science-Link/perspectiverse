# Copy to .env and fill in. Never commit .env.
# The public Bluesky search works with these left blank.
# Set both to use an app password (Bluesky settings → App passwords).

BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Local labels. Leave unset to skip Ollama and use the fallback title.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional paid path. About 60 short JSON calls per snapshot, not one per post.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
