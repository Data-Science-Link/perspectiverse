# Copy to .env and fill in. Never commit .env.
# The pipeline loads this file on start without overriding real environment
# variables (GitHub Actions secrets and Cursor environment secrets win).

# --- Bluesky (daily ingest) ---
# Leave both blank to use anonymous public AppView search.
# GitHub-hosted runners and many cloud IPs get HTTP 403 on that path.
# Create an *app password* (never the account password):
#   1. https://bsky.app/settings/app-passwords
#   2. Name it perspectiverse-pipeline and copy it once
#   3. Put the same two values in GitHub Actions secrets
#      https://github.com/Data-Science-Link/perspectiverse/settings/secrets/actions
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Local labels (optional) ---
# Leave unset to skip Ollama and fall through to an API key or the heuristic.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI-compatible labels (DeepInfra recommended) ---
# About 50 short JSON calls per snapshot (10 planet names + faces/steelmans).
# Reuse the OPENAI_* names; the client is OpenAI-compatible.
# Create a token at https://deepinfra.com/dash then set:
#   GitHub Actions secrets OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL
# Llama 3.3 70B Turbo is ~$0.01/snapshot, ~$0.30/month on the daily job.
# Alternatives: deepseek-ai/DeepSeek-V4-Flash, Qwen/Qwen3.5-9B.
# Jev (below) does not replace these. DeepInfra still writes names and steelmans.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- Jev (per-post spam, public-claim, and newspaper section) ---
# Jev does not write planet names. DeepInfra still does that.
# Spam drops at 0.8. A public claim is kept at 0.5. Non-claims stay stored
# and do not count toward the 10,000. Create a key in the TypeSafe console,
# then set the same name as a GitHub Actions secret. Leave it blank and a
# live Bluesky run stops instead of clustering unlabeled posts. Fixtures and
# --relabel of an unlabeled file still run.
# JEV_MODEL is optional. Unset sends jev-latest (the docs default).
TYPESAFE_API_KEY=
JEV_MODEL=

# --- Cloudflare R2 (retained corpus) ---
# Leave these blank to keep live_corpus.db on the data-snapshot branch.
# At ~100k posts that SQLite file no longer fits in git. Create a private
# bucket named perspectiverse-corpus, then set the same four names as
# GitHub Actions secrets. The daily job downloads the file before --db and
# uploads it only after a successful run. public/data.json stays in git.
# Endpoint shape: https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET defaults to perspectiverse-corpus when the three secrets above are set.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
# Optional. Defaults to live_corpus.db. Set live_corpus_preview.db to write a
# second object in the same bucket without replacing the daily job's file.
R2_OBJECT_KEY=
